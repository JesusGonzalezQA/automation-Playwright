{
  "name": "playwright-mark",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "devDependencies": {
    "@faker-js/faker": "^9.8.0",
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.15.21"
  },
  "scripts": {
    "test": "playwright test",
    "test:home": "playwright test tests/home.spec.ts --headed",
    "test:tasks": "playwright test tests/tasks.spec.ts --headed",
    "test:meetings": "playwright test tests/meetings.spec.ts --headed",
    "test:whatsapp": "playwright test tests/meetings.spec.ts --headed -g /whatsapp/i",
    "test:teams": "playwright test tests/meetings.spec.ts --headed -g /teams/i",
    "report": "playwright show-report"
  }
}
